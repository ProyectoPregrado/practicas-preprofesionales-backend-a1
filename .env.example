DATABASE_URL="postgresql://practicas:practicas@localhost:5432/practicas?schema=public"
JWT_SECRET="cambiame-en-produccion"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Puerto en el que docker-compose publica Postgres. Si 5432 ya está ocupado en
# tu máquina, cámbialo aquí y en DATABASE_URL.
POSTGRES_PORT=5432

# Zona horaria de la institución (nombre IANA). Define el día de una fecha con hora y qué es «hoy».
# INSTITUTION_TIME_ZONE=America/Guayaquil

# DOC-1: carpeta donde se guardan los archivos de los documentos. En producción, un volumen persistente con
# respaldo: si se pierde, los documentos quedan registrados pero sin archivo.
# UPLOAD_DIR=uploads

# IA-1/IA-2: el asistente (dictar horas, semáforo del tutor, revisar documentos) funciona con Claude o con Gemini.
# AI_PROVIDER elige cuál (claude o gemini); si no está, se usa el primero que tenga clave. Sin ninguna clave, esas
# funciones responden con su modo básico, sin IA.
# AI_PROVIDER=gemini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=            (gratis en https://aistudio.google.com/apikey)
# Uno o varios modelos separados por comas: si uno está saturado, se prueba el siguiente.
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.7-flash,gemini-flash-latest
